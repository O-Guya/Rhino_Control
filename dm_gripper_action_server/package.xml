<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dm_gripper_action_server</name>
  <version>0.1.0</version>
  <description>
    ROS 2 action server exposing a control_msgs/action/GripperCommand interface
    for the DM4310-based screw-drive gripper.
  </description>
  <maintainer email="todo@todo.com">Rhino Control</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>dm_motor_driver</depend>
  <depend>dm_gripper_core</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
