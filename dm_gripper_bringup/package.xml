<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dm_gripper_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and configuration for the DM4310 screw-drive gripper.
    Supports standalone (bare motor) and full ros2_control bringup modes.
  </description>
  <maintainer email="todo@todo.com">Rhino Control</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>dm_motor_driver</exec_depend>
  <exec_depend>dm_gripper_core</exec_depend>
  <exec_depend>dm_gripper_hardware</exec_depend>
  <exec_depend>dm_gripper_action_server</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
